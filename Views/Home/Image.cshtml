    const API_URL = "http://localhost:5000/api"; // Đổi lại URL của API nếu cần
    // 🖼 Load danh sách ảnh
    async function loadImages() {
        const response = await fetch(`${domain}/api/get-images`);
        const images = await response.json();
        const gallery = document.getElementById("imageGallery");
        gallery.innerHTML = "";

        images.forEach(img => {
            const imgContainer = document.createElement("div");
            imgContainer.innerHTML = `
                    <img src="${img.filePath}" alt="Ảnh">
                    <button onclick="deleteImage(${img.id})">Xóa</button>
                `;
            gallery.appendChild(imgContainer);
        });
    }

    // 📤 Upload ảnh
    async function uploadImages() {
        const input = document.getElementById("imag");
        const files = input.files;

        if (files.length === 0) {
            alert("Vui lòng chọn ít nhất một ảnh!");
            return;
        }
        console.log(files.length);
        const formData = new FormData();
        for (let file of files) {
