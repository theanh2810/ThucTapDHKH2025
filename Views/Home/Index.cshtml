    const API_URL = "http://localhost:5000/api"; // Đổi lại URL của API nếu cần

    // Hiển thị preview ảnh và nhập mô tả
    document.getElementById('imag').addEventListener('change', function () {
        const files = this.files;
        const previewContainer = document.getElementById('imagePreviewContainer');
        previewContainer.innerHTML = '';

        for (let i = 0; i < files.length; i++) {
            const file = files[i];
            const reader = new FileReader();

            reader.onload = function (e) {
                const previewItem = document.createElement('div');
                previewItem.className = 'image-preview-item';
                previewItem.innerHTML = `
                        <img src="${e.target.result}" class="it" alt="Image Preview" />
                        <input type="text" name="descriptions" placeholder="Enter description" />
                        <button type="button" class="rmv" onclick="removePreview(this)">x</button>
                    `;
                previewContainer.appendChild(previewItem);
            };

            reader.readAsDataURL(file);
        }
    });

    // Xóa preview ảnh
    function removePreview(button) {
        const previewItem = button.parentElement;
        previewItem.remove();
    }

    // Upload ảnh và mô tả
    async function uploadImages() {
        const form = document.getElementById('uploadForm');
        const formData = new FormData(form);

        const response = await fetch(`${API_URL}/Upload/multiple-images`, {
            method: "POST",
            body: formData
        });

        if (response.ok) {
            const data = await response.json();
            alert("Tải ảnh lên thành công!");
            // Load lại danh sách ảnh nếu cần
        } else {
            alert("Có lỗi xảy ra!");
        }
    }

    // Xóa ảnh
    async function deleteImage(id) {
        const response = await fetch(`${API_URL}/delete-image/${id}`, {
            method: "DELETE"
        });

        if (response.ok) {
            alert("Xóa ảnh thành công!");
            loadImages();
        } else {
            alert("Lỗi khi xóa ảnh!");
        }
    }

    // Tải danh sách ảnh khi trang load
    // document.addEventListener("DOMContentLoaded", loadImages);
</script>
